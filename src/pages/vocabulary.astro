---
import BaseLayout from "../layouts/BaseLayout.astro";
import UiText from "../components/UiText.astro";
import SessionSize from "../components/SessionSize.astro";
import VocabularyNavigation from "../components/VocabularyNavigation.astro";
---

<BaseLayout
  title={{ zh: "单词记忆", en: "Word memory" }}
  description={{
    zh: "创建个人单词卡片，按复习计划学习并同步学习进度。",
    en: "Create personal word cards, review them on a schedule, and sync your progress.",
  }}
>
  <section class="page-intro vocabulary-intro">
    <VocabularyNavigation />
    <p class="kicker"><UiText zh="每日练习" en="DAILY PRACTICE" /></p>
    <h1><UiText zh="把新词，变成熟悉。" en="Make new words familiar." /></h1>
    <p class="vocabulary-lead">
      <UiText
        zh="添加自己的词条，系统会为你安排复习节奏。"
        en="Add your own words and let your review schedule take shape."
      />
    </p>
  </section>

  <section class="vocabulary-panel" aria-labelledby="vocabulary-title">
    <div class="vocabulary-config-warning" data-config-warning hidden>
      <strong
        data-ui-text
        data-zh="还差一步配置"
        data-en="One setup step remains">还差一步配置</strong
      >
      <p
        data-ui-text
        data-zh="背词服务尚未连接。请按 README 中的 Supabase 设置说明配置站点环境变量和数据库。"
        data-en="The vocabulary service is not connected yet. Follow the Supabase setup steps in README to configure the site environment and database."
      >
        背词服务尚未连接。请按 README 中的 Supabase
        设置说明配置站点环境变量和数据库。
      </p>
    </div>

    <div class="vocabulary-login" data-login-panel hidden>
      <div>
        <p class="eyebrow"><UiText zh="个人词库" en="YOUR WORD LIST" /></p>
        <h2 id="vocabulary-title">
          <UiText zh="登录后开始复习" en="Sign in to start reviewing" />
        </h2>
        <p class="vocabulary-muted">
          <UiText
            zh="登录链接只会发送给已获授权的账号。"
            en="A sign-in link is sent only to an authorized account."
          />
        </p>
      </div>
      <form class="vocabulary-login-form" data-login-form>
        <label for="login-email"
          ><UiText zh="邮箱地址" en="Email address" /></label
        >
        <input
          id="login-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          data-ui-placeholder
          data-zh="输入你的登录邮箱"
          data-en="Enter your sign-in email"
          placeholder="输入你的登录邮箱"
        />
        <button
          class="vocabulary-primary"
          type="submit"
          data-ui-text
          data-zh="发送登录链接"
          data-en="Send sign-in link">发送登录链接</button
        >
      </form>
    </div>

    <div class="vocabulary-app" data-app-panel hidden>
      <div class="vocabulary-toolbar">
        <div>
          <p class="eyebrow"><UiText zh="个人词库" en="YOUR WORD LIST" /></p>
          <p class="vocabulary-user" data-user-email></p>
        </div>
        <button
          class="vocabulary-quiet"
          type="button"
          data-sign-out
          data-ui-text
          data-zh="退出登录"
          data-en="Sign out">退出登录</button
        >
      </div>

      <div
        class="vocabulary-tabs"
        role="tablist"
        data-ui-aria-label
        data-zh="背词功能"
        data-en="Vocabulary tools"
        aria-label="背词功能"
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-tab="study"
          data-ui-text
          data-zh="今日复习"
          data-en="Today's review">今日复习</button
        >
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-tab="manage"
          data-ui-text
          data-zh="管理词条"
          data-en="Manage words">管理词条</button
        >
      </div>

      <section class="vocabulary-view" data-view="study" role="tabpanel">
        <div class="vocabulary-stats">
          <div>
            <strong data-due-count>0</strong><span
              data-ui-text
              data-zh="待复习"
              data-en="Due">待复习</span
            >
          </div>
          <div>
            <strong data-new-count>0</strong><span
              data-ui-text
              data-zh="今日新词剩余"
              data-en="New words left today">今日新词剩余</span
            >
          </div>
          <div>
            <strong data-total-count>0</strong><span
              data-ui-text
              data-zh="词库总数"
              data-en="Total words">词库总数</span
            >
          </div>
        </div>

        <form class="conjugation-setup" data-word-setup>
          <SessionSize prefix="word" />
          <button type="submit" class="vocabulary-primary"
            ><UiText zh="开始本轮" en="Start round" /></button
          >
        </form>
        <p class="vocabulary-muted" data-session-note role="status"></p>
        <p data-session-progress role="status"></p>
        <div class="conjugation-summary" data-word-summary tabindex="-1" hidden>
        </div>
        <div class="vocabulary-study" data-study-card hidden>
          <p class="vocabulary-card-label" data-card-label></p>
          <button
            class="vocabulary-flashcard"
            type="button"
            data-flashcard
            aria-expanded="false"
          >
            <span class="vocabulary-card-word" data-card-word></span>
            <span class="vocabulary-card-hint" data-card-hint></span>
            <span class="vocabulary-card-answer" data-card-answer hidden>
              <span data-card-meaning></span>
              <span class="vocabulary-card-example" data-card-example></span>
            </span>
          </button>
          <div class="vocabulary-rating" data-ratings hidden>
            <p
              data-ui-text
              data-zh="你记得这个词吗？"
              data-en="How well did you remember it?"
            >
              你记得这个词吗？
            </p>
            <div>
              <button type="button" data-rating="again"
                ><span data-ui-text data-zh="忘记" data-en="Again">忘记</span
                ><small data-ui-text data-zh="10 分钟" data-en="10 min"
                  >10 分钟</small
                ></button
              >
              <button type="button" data-rating="hard"
                ><span data-ui-text data-zh="困难" data-en="Hard">困难</span
                ><small data-ui-text data-zh="1 天" data-en="1 day">1 天</small
                ></button
              >
              <button type="button" data-rating="good"
                ><span data-ui-text data-zh="认识" data-en="Good">认识</span
                ><small data-rating-hint="good"></small></button
              >
              <button type="button" data-rating="easy"
                ><span data-ui-text data-zh="简单" data-en="Easy">简单</span
                ><small data-rating-hint="easy"></small></button
              >
            </div>
          </div>
        </div>
        <div class="vocabulary-empty" data-study-empty hidden>
          <strong data-empty-title></strong>
          <p data-empty-copy></p>
          <button
            class="vocabulary-primary"
            type="button"
            data-empty-manage
            data-ui-text
            data-zh="添加单词"
            data-en="Add a word">添加单词</button
          >
        </div>
      </section>

      <section
        class="vocabulary-view"
        data-view="manage"
        role="tabpanel"
        hidden
      >
        <div class="vocabulary-manager">
          <form class="vocabulary-word-form" data-word-form>
            <div class="vocabulary-form-heading">
              <h2
                data-form-title
                data-ui-text
                data-zh="添加单词"
                data-en="Add a word"
              >
                添加单词
              </h2>
              <button
                class="vocabulary-quiet"
                type="button"
                data-cancel-edit
                hidden
                data-ui-text
                data-zh="取消编辑"
                data-en="Cancel edit">取消编辑</button
              >
            </div>
            <label for="word-input"
              ><UiText zh="英文单词" en="English word" /></label
            >
            <input
              id="word-input"
              name="word"
              maxlength="120"
              required
              autocomplete="off"
            />
            <label for="meaning-input"
              ><UiText zh="中文释义" en="Chinese meaning" /></label
            >
            <textarea
              id="meaning-input"
              name="meaning"
              rows="2"
              maxlength="500"
              required></textarea>
            <label for="example-input"
              ><UiText zh="例句（选填）" en="Example (optional)" /></label
            >
            <textarea
              id="example-input"
              name="example"
              rows="2"
              maxlength="1000"></textarea>
            <button
              class="vocabulary-primary"
              type="submit"
              data-save-word
              data-ui-text
              data-zh="保存词条"
              data-en="Save word">保存词条</button
            >
          </form>
          <div class="vocabulary-word-list-wrap">
            <div class="vocabulary-list-heading">
              <h2><UiText zh="我的词条" en="My words" /></h2>
              <span data-list-count>0</span>
            </div>
            <div class="vocabulary-word-list" data-word-list></div>
            <p
              class="vocabulary-list-empty"
              data-list-empty
              data-ui-text
              data-zh="还没有单词，先添加一个吧。"
              data-en="No words yet. Add your first one."
            >
              还没有单词，先添加一个吧。
            </p>
          </div>
        </div>
      </section>
    </div>

    <p class="vocabulary-status" data-status role="status" aria-live="polite">
    </p>
  </section>
</BaseLayout>

<script>
  import "../scripts/vocabulary";
</script>
