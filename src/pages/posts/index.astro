---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import UiText from '../../components/UiText.astro';
import { getPublishedPosts } from '../../lib/posts';
const posts = await getPublishedPosts();
---
<BaseLayout title="文章">
  <section class="page-intro"><p class="kicker"><UiText zh="文章归档" en="ARCHIVE" /></p><h1><UiText zh="所有文章" en="All articles" /></h1></section>
  <div class="filter-row"><a href="/posts/" class="active">All</a><a href="/languages/zh/">中文</a><a href="/languages/en/">English</a></div>
  <div class="post-grid archive-grid">{posts.map((post) => <PostCard post={post} />)}</div>
</BaseLayout>
