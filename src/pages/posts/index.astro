---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import UiText from '../../components/UiText.astro';
import { getPublishedPosts } from '../../lib/posts';
const posts = await getPublishedPosts();
---
<BaseLayout title="文章">
  <section class="page-intro"><p class="kicker"><UiText zh="文章归档" en="ARCHIVE" fr="ARCHIVES" /></p><h1><UiText zh="所有文章" en="All articles" fr="Tous les articles" /></h1></section>
  <div class="filter-row"><a href="/posts/" class="active"><UiText zh="全部" en="All" fr="Tous" /></a><a href="/languages/zh/"><UiText zh="中文" en="Chinese" fr="Chinois" /></a><a href="/languages/en/"><UiText zh="英文" en="English" fr="Anglais" /></a></div>
  <div class="post-grid archive-grid">{posts.map((post) => <PostCard post={post} />)}</div>
</BaseLayout>
