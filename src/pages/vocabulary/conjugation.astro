---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UiText from "../../components/UiText.astro";
import VocabularyNavigation from "../../components/VocabularyNavigation.astro";
import SessionSize from "../../components/SessionSize.astro";
import { tenses } from "../../lib/conjugation";
---

<BaseLayout
  title={{ zh: "法语动词变位", en: "French conjugation" }}
  description={{
    zh: "100 个法语动词，练习六种时态或中文释义。自选每轮数量，记录你的进步。",
    en: "Practice conjugation or Chinese meanings for 100 French verbs, with a round size you choose.",
  }}
>
  <section class="page-intro vocabulary-intro conjugation-intro">
    <VocabularyNavigation />
    <p class="kicker">
      <UiText zh="法语 · 每日练习" en="FRENCH · DAILY PRACTICE" />
    </p>
    <h1><UiText zh="让变位，成为习惯。" en="Find your French rhythm." /></h1>
    <p class="vocabulary-lead">
      <UiText
        zh="100 个常用动词，练习变位或中文含义。自选每轮数量，慢慢熟悉。"
        en="100 common verbs. Practice conjugation or Chinese meanings, with a round size you choose."
      />
    </p>
  </section>

  <section
    class="vocabulary-panel conjugation-panel"
    aria-labelledby="conjugation-title"
  >
    <h2 id="conjugation-title" class="sr-only">
      <UiText zh="法语动词练习" en="French verb practice" />
    </h2>
    <div
      class="verb-practice-modes"
      role="group"
      aria-label="练习模式"
      data-ui-aria-label
      data-zh="练习模式"
      data-en="Practice mode"
    >
      <button
        type="button"
        data-practice-kind="conjugation"
        aria-pressed="true"
      >
        <UiText zh="动词变位" en="Conjugation" />
      </button>
      <button type="button" data-practice-kind="meaning" aria-pressed="false">
        <UiText zh="动词含义" en="Verb meanings" />
      </button>
    </div>
    <div class="vocabulary-config-warning" data-config-warning hidden>
      <strong><UiText zh="还差一步配置" en="One setup step remains" /></strong>
      <p>
        <UiText
          zh="练习服务尚未连接，请按 README 配置 Supabase 环境变量与数据库。"
          en="Connect the practice service by following the Supabase setup in README."
        />
      </p>
    </div>
    <div class="vocabulary-login" data-login-panel hidden>
      <div>
        <p class="eyebrow"><UiText zh="个人练习" en="YOUR PRACTICE" /></p>
        <h2><UiText zh="登录后开始练习" en="Sign in to practice" /></h2>
        <p class="vocabulary-muted">
          <UiText
            zh="使用背单词的授权账号，练习进度会自动同步。"
            en="Use your authorized vocabulary account to sync your progress."
          />
        </p>
      </div>
      <form class="vocabulary-login-form" data-login-form>
        <label for="conjugation-email"
          ><UiText zh="邮箱地址" en="Email address" /></label
        >
        <input
          id="conjugation-email"
          name="email"
          type="email"
          autocomplete="email"
          required
        />
        <button type="submit" class="vocabulary-primary"
          ><UiText zh="发送登录链接" en="Send sign-in link" /></button
        >
      </form>
    </div>
    <div data-app-panel hidden>
      <div class="vocabulary-toolbar">
        <div>
          <p class="eyebrow"><UiText zh="个人练习" en="YOUR PRACTICE" /></p><p
            class="vocabulary-user"
            data-user-email
          >
          </p>
        </div>
        <button type="button" class="vocabulary-quiet" data-sign-out
          ><UiText zh="退出登录" en="Sign out" /></button
        >
      </div>
      <div class="conjugation-loading" data-load-panel>
        <p data-load-message role="status"></p>
        <button type="button" class="vocabulary-quiet" data-reload hidden
          ><UiText zh="重新加载" en="Try again" /></button
        >
      </div>
      <div data-practice-panel hidden>
        <div class="vocabulary-stats conjugation-stats">
          <div>
            <strong data-total-attempts>0</strong><span
              ><span data-attempts-label>累计变位答题</span></span
            >
          </div>
          <div>
            <strong data-total-accuracy>—</strong><span
              ><UiText zh="正确率" en="Accuracy" /></span
            >
          </div>
          <div>
            <strong data-round-score>—</strong><span
              ><UiText zh="本轮答对" en="Correct this round" /></span
            >
          </div>
        </div>
        <form class="conjugation-setup" data-setup>
          <div data-tense-setup>
            <label for="tense-mode"
              ><UiText zh="练习时态" en="Practice tense" /></label
            >
            <select id="tense-mode" name="mode">
              <option
                value="mixed"
                data-ui-text
                data-zh="混合练习 · 六种时态"
                data-en="Mixed · all six tenses">混合练习 · 六种时态</option
              >
              {
                tenses.map((tense) => (
                  <option
                    value={tense.id}
                    data-ui-text
                    data-zh={`${tense.zh} · ${tense.fr}`}
                    data-en={`${tense.en} · ${tense.fr}`}
                  >
                    {tense.zh} · {tense.fr}
                  </option>
                ))
              }
            </select>
          </div>
          <SessionSize prefix="verb" />
          <button type="submit" class="vocabulary-primary"
            ><UiText zh="开始练习" en="Start practice" /></button
          >
        </form>
        <p class="conjugation-instructions" data-practice-instructions></p>
        <div class="conjugation-question" data-question hidden>
          <div class="conjugation-question-meta">
            <span data-question-count></span><span data-question-tense></span>
          </div>
          <progress
            max="10"
            value="0"
            data-round-progress
            data-ui-aria-label
            data-zh="本轮进度"
            data-en="Round progress"
            aria-label="本轮进度"></progress>
          <h2 lang="fr" data-verb></h2>
          <p class="conjugation-person" lang="fr" data-person></p>
          <p class="conjugation-agreement" data-agreement></p>
          <form class="conjugation-answer-form" data-answer-form>
            <label for="conjugation-answer"
              ><span data-answer-label>你的变位答案</span></label
            >
            <input
              id="conjugation-answer"
              name="answer"
              lang="fr"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              maxlength="120"
              required
              aria-describedby="answer-feedback"
            />
            <button class="vocabulary-primary" type="submit" data-check
              >检查答案</button
            >
          </form>
          <div
            class="conjugation-feedback"
            id="answer-feedback"
            data-feedback
            role="status"
            aria-live="polite"
            hidden
          >
            <strong data-verdict></strong>
            <p>
              <UiText zh="标准答案：" en="Standard answer: " /><span
                lang="fr"
                data-standard-answer></span>
            </p>
          </div>
          <div class="meaning-assessment" data-self-assessment hidden>
            <p>
              <UiText
                zh="意思相同，答出任一常用义即可。请对照答案自行判断。"
                en="Any listed common sense is enough. Compare your answer and assess it yourself."
              />
            </p>
            <div
              role="group"
              aria-label="自评结果"
              data-ui-aria-label
              data-zh="自评结果"
              data-en="Self-assessment"
            >
              <button
                type="button"
                class="vocabulary-quiet"
                data-self-rating="false"
              >
                <UiText zh="答错了" en="I got it wrong" />
              </button>
              <button
                type="button"
                class="vocabulary-primary"
                data-self-rating="true"
              >
                <UiText zh="答对了" en="I got it right" />
              </button>
            </div>
          </div>
          <button
            type="button"
            class="vocabulary-primary conjugation-next"
            data-next
            hidden></button>
        </div>
        <div class="conjugation-summary" data-summary tabindex="-1" hidden>
          <p class="eyebrow"><UiText zh="本轮完成" en="ROUND COMPLETE" /></p>
          <h2 data-summary-score></h2>
          <p>
            <UiText
              zh="进度已同步。选择练习模式，再练一轮。"
              en="Progress synced. Choose a practice mode and try another round."
            />
          </p>
        </div>
        <div class="conjugation-sync" data-sync-panel hidden>
          <p data-sync-message role="status"></p>
          <button type="button" class="vocabulary-quiet" data-retry hidden
            ><UiText zh="重试同步" en="Retry sync" /></button
          >
        </div>
        <details class="conjugation-performance" open>
          <summary data-performance-title>各时态表现</summary>
          <p class="vocabulary-muted" data-last-practiced></p>
          <div data-tense-stats></div>
        </details>
      </div>
    </div>
    <p class="vocabulary-status" data-status role="status" aria-live="polite">
    </p>
  </section>
</BaseLayout>

<script>
  import "../../scripts/conjugation";
</script>
