---
import UiText from "./UiText.astro";
---

<details class="mistake-review" data-mistake-panel>
  <summary
    ><UiText zh="错题本" en="Mistake notebook" />
    <span data-mistake-count></span></summary
  >
  <p class="vocabulary-muted">
    <UiText
      zh="复习间隔：10 分钟 → 1 天 → 3 天 → 7 天 → 14 天 → 30 天。到期答对推进，答错重新安排。"
      en="Review after 10 min → 1 → 3 → 7 → 14 → 30 days. Correct due reviews advance; mistakes restart the schedule."
    />
  </p>
  <p data-mistake-status role="status"></p>
  <div class="mistake-list" data-mistake-list></div>
</details>
