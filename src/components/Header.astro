---
import { site } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';
import UiText from './UiText.astro';
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<header class="site-header">
  <a class="brand" href="/" aria-label={site.name}>{site.name}<span>·</span></a>
  <nav aria-label="Primary navigation">
    <a href="/" aria-current={isActive('/') ? 'page' : undefined}><UiText zh="首页" en="Home" fr="Accueil" /></a>
    <a href="/posts/" aria-current={isActive('/posts/') ? 'page' : undefined}><UiText zh="文章" en="Articles" fr="Articles" /></a>
    <a href="/search/" aria-current={isActive('/search/') ? 'page' : undefined}><UiText zh="搜索" en="Search" fr="Recherche" /></a>
    <a href="/about/" aria-current={isActive('/about/') ? 'page' : undefined}><UiText zh="关于我" en="About" fr="À propos" /></a>
  </nav>
  <div class="header-actions">
    <details class="language-menu" data-language-menu>
      <summary aria-label="选择界面语言"><span class="language-current" data-language-current>中文</span><span class="language-chevron" aria-hidden="true">⌄</span></summary>
      <div class="language-options" aria-label="选择界面语言">
        <button type="button" data-language-option="zh">中文</button>
        <button type="button" data-language-option="en">English</button>
        <button type="button" data-language-option="fr">Français</button>
      </div>
    </details>
    <ThemeToggle />
  </div>
</header>
