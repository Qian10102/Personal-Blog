---
import { site } from "../config/site";
import ThemeToggle from "./ThemeToggle.astro";
import UiText from "./UiText.astro";
---

<header class="site-header">
  <a
    class="brand"
    href="/"
    data-ui-aria-label
    data-zh={site.name}
    data-en={site.nameEn}
    aria-label={site.name}
    ><span class="brand-name" data-ui-text data-zh="钱子晗" data-en="Zihan's"
      >钱子晗</span
    ><span class="brand-suffix" data-ui-text data-zh="的blog" data-en=" blog"
      >的blog</span
    ><span class="brand-separator">·</span></a
  >
  <nav aria-label="Primary navigation">
    <a href="/"><UiText zh="首页" en="Home" /></a>
    <a href="/posts/"><UiText zh="文章" en="Articles" /></a>
    <a href="/search/"><UiText zh="搜索" en="Search" /></a>
    <a href="/about/"><UiText zh="关于我" en="About" /></a>
  </nav>
  <div class="header-actions">
    <details class="language-menu" data-language-menu>
      <summary
        data-language-summary
        data-ui-aria-label
        data-zh="选择界面语言"
        data-en="Choose interface language"
        aria-label="选择界面语言"
        aria-controls="language-options"
        aria-expanded="false"><span data-language-current>中文</span></summary
      >
      <div
        id="language-options"
        class="language-options"
        data-ui-aria-label
        data-zh="选择界面语言"
        data-en="Choose interface language"
        aria-label="选择界面语言"
      >
        <button type="button" data-language-option="zh" aria-current="true">
          中文
        </button>
        <button type="button" data-language-option="en" aria-current="false">
          English
        </button>
      </div>
    </details>
    <ThemeToggle />
  </div>
</header>
