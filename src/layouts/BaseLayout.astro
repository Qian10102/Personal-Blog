---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { site } from "../config/site";
type LocalizedText = { zh: string; en: string };
interface Props {
  title?: string | LocalizedText;
  description?: string | LocalizedText;
}
const { title, description = site.description } = Astro.props;
const localize = (text: string | LocalizedText): LocalizedText =>
  typeof text === "string" ? { zh: text, en: text } : text;
const localizedDescription = localize(description);
const localizedTitle = title ? localize(title) : null;
const pageTitle = localizedTitle
  ? {
      zh: `${localizedTitle.zh} · ${site.name}`,
      en: `${localizedTitle.en} · ${site.nameEn}`,
    }
  : {
      zh: `${site.name} · ${site.description}`,
      en: `${site.nameEn} · ${site.descriptionEn}`,
    };
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-ui-language="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={localizedDescription.zh}
      data-ui-description
      data-zh={localizedDescription.zh}
      data-en={localizedDescription.en}
    />
    <meta name="color-scheme" content="light dark" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} RSS`}
      href="/rss.xml"
    />
    <title data-ui-title data-zh={pageTitle.zh} data-en={pageTitle.en}>
      {pageTitle.zh}
    </title>
    <script is:inline>
      const storedTheme = localStorage.getItem("theme");
      const theme =
        storedTheme ||
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.dataset.theme = theme;
      const browserLanguage = navigator.language.toLowerCase();
      const storedLanguage = localStorage.getItem("ui-language");
      const language =
        storedLanguage === "zh" || storedLanguage === "en"
          ? storedLanguage
          : browserLanguage.startsWith("zh")
            ? "zh"
            : "en";
      document.documentElement.dataset.uiLanguage = language;
      document.documentElement.lang = language === "zh" ? "zh-CN" : "en";
      const pageTitle = document.querySelector("[data-ui-title]");
      if (pageTitle)
        document.title =
          pageTitle.dataset[language] || pageTitle.dataset.zh || "";
      const pageDescription = document.querySelector("[data-ui-description]");
      if (pageDescription)
        pageDescription.content =
          pageDescription.dataset[language] || pageDescription.dataset.zh || "";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      <span data-ui-text data-zh="跳至主要内容" data-en="Skip to content">
        跳至主要内容
      </span>
    </a>
    <div class="page-shell">
      <div class="site-chrome"><Header /></div>
      <main id="main-content"><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">
          京ICP备2026048723号
        </a><a href="/rss.xml">RSS</a>
      </footer>
    </div>
    <script>
      const languageNames = { zh: "中文", en: "English" };
      const languageMenu = document.querySelector<HTMLDetailsElement>(
        "[data-language-menu]",
      );
      const languageMenuSummary = document.querySelector<HTMLElement>(
        "[data-language-summary]",
      );
      const languageOptions = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-language-option]"),
      );

      function applyLanguage(candidate: string) {
        const language = candidate === "zh" ? "zh" : "en";
        document.documentElement.dataset.uiLanguage = language;
        document.documentElement.lang = language === "zh" ? "zh-CN" : "en";
        document
          .querySelectorAll<HTMLElement>("[data-ui-text]")
          .forEach(
            (el) =>
              (el.textContent = el.dataset[language] || el.dataset.en || ""),
          );
        document
          .querySelectorAll<HTMLInputElement>("[data-ui-placeholder]")
          .forEach(
            (el) =>
              (el.placeholder = el.dataset[language] || el.dataset.en || ""),
          );
        document
          .querySelectorAll<HTMLElement>("[data-ui-aria-label]")
          .forEach((el) =>
            el.setAttribute(
              "aria-label",
              el.dataset[language] || el.dataset.en || "",
            ),
          );
        const pageTitle =
          document.querySelector<HTMLTitleElement>("[data-ui-title]");
        if (pageTitle)
          document.title =
            pageTitle.dataset[language] || pageTitle.dataset.zh || "";
        const pageDescription = document.querySelector<HTMLMetaElement>(
          "[data-ui-description]",
        );
        if (pageDescription)
          pageDescription.content =
            pageDescription.dataset[language] ||
            pageDescription.dataset.zh ||
            "";
        const current = document.querySelector<HTMLElement>(
          "[data-language-current]",
        );
        if (current)
          current.textContent =
            languageNames[language as keyof typeof languageNames] ||
            languageNames.zh;
        languageOptions.forEach((option) => {
          option.setAttribute(
            "aria-current",
            String(option.dataset.languageOption === language),
          );
        });
        document.dispatchEvent(
          new CustomEvent("ui-language-change", { detail: { language } }),
        );
      }
      applyLanguage(document.documentElement.dataset.uiLanguage || "zh");

      function closeLanguageMenu(restoreFocus = false) {
        if (!languageMenu?.open) return;
        languageMenu.open = false;
        if (restoreFocus) languageMenuSummary?.focus({ preventScroll: true });
      }

      languageMenu?.addEventListener("toggle", () => {
        languageMenuSummary?.setAttribute(
          "aria-expanded",
          String(languageMenu.open),
        );
      });

      languageMenuSummary?.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowDown") return;
        if (!languageMenu) return;
        event.preventDefault();
        languageMenu.open = true;
        languageOptions
          .find((option) => option.getAttribute("aria-current") === "true")
          ?.focus({ preventScroll: true });
      });

      document.addEventListener("pointerdown", (event) => {
        if (
          languageMenu?.open &&
          event.target instanceof Node &&
          !languageMenu.contains(event.target)
        ) {
          closeLanguageMenu();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !languageMenu?.open) return;
        event.preventDefault();
        closeLanguageMenu(true);
      });
      const themeToggle = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
      );

      function applyTheme(candidate: string) {
        const theme = candidate === "dark" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        themeToggle?.setAttribute("aria-pressed", String(theme === "dark"));
      }

      applyTheme(document.documentElement.dataset.theme || "light");
      themeToggle?.addEventListener("click", () => {
        const next =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        applyTheme(next);
        localStorage.setItem("theme", next);
      });
      languageOptions.forEach((option, index) => {
        option.addEventListener("click", () => {
          const language = option.dataset.languageOption;
          if (!language) return;
          localStorage.setItem("ui-language", language);
          applyLanguage(language);
          closeLanguageMenu();
        });
        option.addEventListener("keydown", (event) => {
          if (event.key === "Escape") return;
          const direction =
            event.key === "ArrowDown" || event.key === "ArrowRight"
              ? 1
              : event.key === "ArrowUp" || event.key === "ArrowLeft"
                ? -1
                : 0;
          if (!direction) return;
          event.preventDefault();
          const nextIndex =
            (index + direction + languageOptions.length) %
            languageOptions.length;
          languageOptions[nextIndex]?.focus({ preventScroll: true });
        });
      });
    </script>
  </body>
</html>
